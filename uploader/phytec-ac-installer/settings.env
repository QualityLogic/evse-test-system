# =============================================================================
# Everest Test System - Installation Settings
# =============================================================================
# Edit the values below to customize the Everest installation.
# These settings are read by everest.sh during install, uninstall, and modify.

# Name of the Everest config file to use. This must be a file found within
# the "everest/config/" directory of the runtime archive.
EVEREST_CONFIG_FILE="config-phytec-ac-ocpp-pnc-test.yaml"

# Absolute path to the directory where the custom Everest firmware will be
# installed. The contents of the runtime archive are extracted here.
EVEREST_INSTALL_DIR="/var/ev-test-sys"

# Path to the compressed runtime archive, relative to the installer directory.
EVEREST_ARCHIVE_FILE="bin/runtime.tar.gz"

# Absolute path to the directory containing systemd service files.
EVEREST_SERVICE_DIR="/lib/systemd/system"

# Name of the systemd service that starts Everest at system startup.
# The installer will look for a "<name>.service" file in EVEREST_SERVICE_DIR.
EVEREST_SERVICE="basecamp"
