# =============================================================================
# Everest Test System - Upload Settings
# =============================================================================
# Edit the values below to configure the remote upload target.
# These settings are read by upload.sh when copying installer files to the
# remote system.

# IP address or hostname of the remote EV charger.
REMOTE_HOST="192.168.3.11"

# SSH user on the remote system used for the SCP connection.
REMOTE_USER="root"

# Absolute path on the remote system where the installer directory will be
# copied to.
REMOTE_INSTALLER_PATH="~/everest_installer"

# Path to the local installer directory, relative to this settings file.
LOCAL_INSTALLER_DIR="phytec-ac-installer"
